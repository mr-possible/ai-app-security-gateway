# Copy to .env and fill in locally. NEVER commit .env (it is gitignored).
# Blank values mean "not set". Every value is validated at startup.

ENVIRONMENT=development          # development | test | production
LOG_LEVEL=INFO

# --- OpenAI -------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=                    # pick a current chat model from platform.openai.com/docs/models
OPENAI_TIMEOUT_SECONDS=30

# --- Langfuse tracing (https://cloud.langfuse.com) ----------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Guardrail tuning ---------------------------------------------------------
INJECTION_BLOCK_THRESHOLD=0.7
INJECTION_MEDIUM_THRESHOLD=0.4
OUTPUT_LEAK_THRESHOLD=0.2
MAX_PROMPT_CHARS=20000
RESTORE_PII_IN_RESPONSE=true
EXPOSE_VIOLATION_DETAILS=false   # never true in production
